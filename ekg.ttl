ekg: a owl:Ontology ;
    rdfs:label "Soccer Event Knowledge Graph" ;
    owl:versionInfo "2.1" .

ekg:ASSISTED_BY a owl:ObjectProperty ;
    rdfs:label "ASSISTED_BY" ;
    rdfs:domain ekg:Event ;
    rdfs:range ekg:Player .

ekg:INVOLVED_IN a owl:ObjectProperty ;
    rdfs:label "INVOLVED_IN" ;
    rdfs:domain ekg:Team ;
    rdfs:range ekg:Event .

ekg:IN_MATCH a owl:ObjectProperty ;
    rdfs:label "IN_MATCH" ;
    rdfs:domain ekg:Event ;
    rdfs:range ekg:Match .

ekg:IS_PERFORMED_BY a owl:ObjectProperty ;
    rdfs:label "IS_PERFORMED_BY" ;
    rdfs:domain ekg:Event ;
    rdfs:range ekg:Player ;
    owl:inverseOf ekg:PERFORMED .

ekg:OffsideEvent a owl:Class ;
    rdfs:label "OffsideEvent" ;
    rdfs:subClassOf ekg:ActionEvent .

ekg:PARTICIPATED_IN a owl:ObjectProperty ;
    rdfs:label "PARTICIPATED_IN" ;
    rdfs:domain ekg:Player ;
    rdfs:range ekg:Match .

ekg:PRECEDES a owl:ObjectProperty ;
    rdfs:label "PRECEDES" ;
    rdfs:domain ekg:Event ;
    rdfs:range ekg:Event ;
    owl:inverseOf ekg:PRECEDED_BY .

ekg:PassEvent a owl:Class ;
    rdfs:label "PassEvent" ;
    rdfs:subClassOf ekg:ActionEvent .

ekg:PenaltyEvent a owl:Class ;
    rdfs:label "PenaltyEvent" ;
    rdfs:subClassOf ekg:ActionEvent .

ekg:RedCardEvent a owl:Class ;
    rdfs:label "RedCardEvent" ;
    rdfs:subClassOf ekg:CardEvent .

ekg:TRIGGERED a owl:ObjectProperty ;
    rdfs:label "TRIGGERED" ;
    rdfs:domain ekg:ActionEvent ;
    rdfs:range ekg:CardEvent .

ekg:detectedJersey a owl:DatatypeProperty ;
    rdfs:label "detectedJersey" ;
    rdfs:domain ekg:Event ;
    rdfs:range xsd:string .

ekg:hasAwayTeam a owl:ObjectProperty ;
    rdfs:label "hasAwayTeam" ;
    rdfs:domain ekg:Match ;
    rdfs:range ekg:Team .

